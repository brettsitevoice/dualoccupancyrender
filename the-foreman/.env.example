# The Foreman — environment variables
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Anthropic API key. Kept on the server only — it is never sent to the browser.
# Without it the game still runs, using the built-in (non-AI) foreman notes.
ANTHROPIC_API_KEY=

# Model used for the foreman. Default: claude-fable-5-2
# FOREMAN_MODEL=claude-fable-5-2

# How hard the model thinks: low | medium | high. Lower is faster on a phone.
# FOREMAN_EFFORT=low
# FOREMAN_PHOTO_EFFORT=medium

# Database. Default is a local SQLite file at ./data/foreman.db
# For a hosted SQLite database (e.g. Turso) use a libsql:// URL and a token.
# DATABASE_URL=file:./data/foreman.db
# DATABASE_AUTH_TOKEN=

# Optional class code. If set, students must enter it to create an account.
# SIGNUP_CODE=
